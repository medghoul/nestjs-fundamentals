{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Dev",
      "program": "${workspaceFolder}/app.js",
      "skipFiles": ["<node_internals>/**"],
      "outFiles": ["${workspaceFolder}/**/*.js"],
      "console": "integratedTerminal",
      "runtimeExecutable": "${env:HOME}/.nvm/versions/node/v23.10.0/bin/node",
      "runtimeArgs": ["--inspect", "-r", "dotenv/config"],
      "args": ["dotenv_config_path=${workspaceFolder}/.env.development"],
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Staging",
      "program": "${workspaceFolder}/app.js",
      "skipFiles": ["<node_internals>/**"],
      "outFiles": ["${workspaceFolder}/**/*.js"],
      "console": "integratedTerminal",
      "runtimeExecutable": "${env:HOME}/.nvm/versions/node/v23.10.0/bin/node",
      "runtimeArgs": ["--inspect", "-r", "dotenv/config"],
      "args": ["dotenv_config_path=${workspaceFolder}/.env.staging"],
      "env": {
        "NODE_ENV": "staging"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Production",
      "program": "${workspaceFolder}/app.js",
      "skipFiles": ["<node_internals>/**"],
      "outFiles": ["${workspaceFolder}/**/*.js"],
      "console": "integratedTerminal",
      "runtimeExecutable": "${env:HOME}/.nvm/versions/node/v23.10.0/bin/node",
      "runtimeArgs": ["--inspect", "-r", "dotenv/config"],
      "args": ["dotenv_config_path=${workspaceFolder}/.env.production"],
      "env": {
        "NODE_ENV": "production"
      }
    }
  ]
}
